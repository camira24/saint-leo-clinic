
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#F8F5F0">
  <meta name="description" content="Saint Leo Medical Clinic in Barbados. Discover personalised skin health, medical aesthetics and wellness.">

  <title>Saint Leo Medical Clinic | Barbados</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@400;500&display=swap" rel="stylesheet">

  <style>
    :root {
      --charcoal: #36454F;
      --ivory: #F8F5F0;
      --taupe: #C8BEB5;
      --sage: #A7B2A0;
      --text: #514D47;
      --muted: #81786F;
      --white: #FFFFFF;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 30px;
    }

    body {
      margin: 0;
      background: var(--ivory);
      color: var(--text);
      font-family: "DM Sans", Arial, sans-serif;
      font-size: 14px;
      line-height: 1.8;
    }

    img {
      max-width: 100%;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    a:focus-visible {
      outline: 2px solid var(--sage);
      outline-offset: 4px;
    }

    .announcement {
      min-height: 30px;
      padding: 5px 7%;
      background: var(--charcoal);
      color: var(--ivory);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      font-size: 9px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    header {
      min-height: 88px;
      padding: 15px 7%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 28px;
      background: var(--ivory);
    }

    .logo-link {
      display: inline-flex;
      align-items: center;
      flex-shrink: 0;
    }

    .logo-image {
      display: block;
      width: 180px;
      max-width: 40vw;
      max-height: 70px;
      object-fit: contain;
      object-position: left center;
    }

    /* Text fallback appears if logo.png has not been uploaded. */
    .text-logo {
      font-family: "Playfair Display", Georgia, serif;
      font-size: 26px;
      line-height: 1.2;
      letter-spacing: 2px;
    }

    .text-logo small {
      display: block;
      font-family: "DM Sans", sans-serif;
      font-size: 9px;
      letter-spacing: 4px;
      text-align: center;
      margin-top: 4px;
    }

    nav {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 18px;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: .5px;
    }

    nav a:not(.nav-cta):hover {
      text-decoration: underline;
      text-underline-offset: 5px;
    }

    .nav-cta,
    .outline-button {
      display: inline-block;
      padding: 11px 17px;
      border: 1px solid var(--text);
      background: transparent;
      color: var(--text);
      font-family: "DM Sans", sans-serif;
      font-size: 10px;
      letter-spacing: .7px;
      text-align: center;
      text-transform: uppercase;
      transition: background .2s, color .2s;
    }

    .nav-cta:hover,
    .outline-button:hover {
      background: var(--charcoal);
      color: var(--ivory);
    }

    .hero {
      min-height: 490px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: #E9E4DC;
      overflow: hidden;
    }

    .hero-copy {
      align-self: center;
      padding: 65px 12%;
    }

    .eyebrow {
      margin: 0 0 17px;
      color: var(--muted);
      font-size: 10px;
      letter-spacing: 2px;
      line-height: 1.6;
      text-transform: uppercase;
    }

    h1,
    h2,
    h3 {
      margin-top: 0;
      font-family: "Playfair Display", Georgia, serif;
      font-weight: 400;
      line-height: 1.2;
    }

    h1 {
      margin-bottom: 22px;
      font-size: clamp(38px, 5vw, 62px);
    }

    h2 {
      margin-bottom: 20px;
      font-size: clamp(32px, 4vw, 46px);
    }

    h3 {
      font-size: 25px;
    }

    .hero-copy > p:not(.eyebrow) {
      max-width: 440px;
      margin-bottom: 27px;
    }

    .hero-image {
      min-height: 490px;
      background-color: var(--taupe);
      background-image: url("https://images.unsplash.com/photo-1616683693504-3ea7e9ad6fec?auto=format&fit=crop&w=1400&q=85");
      background-position: center 35%;
      background-size: cover;
      background-repeat: no-repeat;
    }

    .section {
      padding: 90px 9%;
    }

    .split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 9%;
    }

    .interior-image {
      min-height: 350px;
      background-color: var(--taupe);
      background-image: url("https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1200&q=85");
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
    }

    .split-copy {
      max-width: 500px;
    }

    .split-copy p:not(.eyebrow) {
      margin-bottom: 26px;
    }

    .services {
      background: #EAE4DB;
      text-align: center;
    }

    .services-intro {
      max-width: 560px;
      margin: 0 auto 42px;
    }

    .service-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
      text-align: left;
    }

    .service {
      padding: 30px 25px;
      background: var(--ivory);
      border-top: 2px solid var(--sage);
    }

    .service-number {
      color: var(--muted);
      font-size: 10px;
      letter-spacing: 2px;
    }

    .service h3 {
      margin: 23px 0 14px;
    }

    .service p {
      margin-bottom: 0;
      font-size: 13px;
    }

    .doctor-section {
      background: var(--ivory);
    }

    .doctor-placeholder {
      min-height: 350px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 25px;
      background: #E9E4DC;
      color: var(--muted);
      text-align: center;
      font-size: 12px;
    }

    .appointment {
      background: var(--sage);
      text-align: center;
    }

    .appointment h2 {
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }

    .appointment p {
      max-width: 500px;
      margin: 0 auto 25px;
    }

    .appointment .outline-button {
      border-color: var(--charcoal);
      background: var(--charcoal);
      color: var(--ivory);
    }

    .appointment .outline-button:hover {
      background: transparent;
      color: var(--charcoal);
    }

    .contact-details {
      text-align: center;
    }

    .contact-details p {
      margin: 7px 0;
    }

    .contact-details a {
      text-underline-offset: 4px;
    }

    .contact-details a:hover {
      text-decoration: underline;
    }

    footer {
      padding: 42px 8%;
      background: var(--charcoal);
      color: var(--ivory);
      text-align: center;
    }

    footer .text-logo {
      margin-bottom: 18px;
    }

    footer p {
      margin: 5px 0;
      font-size: 12px;
    }

    footer a {
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .footer-note {
      margin-top: 22px;
      color: #DDD8D1;
      font-size: 10px;
    }

    @media (max-width: 800px) {
      header {
        flex-direction: column;
        gap: 18px;
        padding: 22px 5%;
      }

      .logo-image {
        width: 175px;
        max-width: 65vw;
      }

      nav {
        justify-content: center;
        gap: 12px 17px;
      }

      .hero {
        grid-template-columns: 1fr;
      }

      .hero-image {
        grid-row: 1;
        min-height: 360px;
      }

      .hero-copy {
        padding: 50px 8%;
      }

      .section {
        padding: 65px 7%;
      }

      .split {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .interior-image,
      .doctor-placeholder {
        min-height: 280px;
      }

      .service-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body>

  <div class="announcement">
    <span>Saint Leo Medical Clinic · Barbados</span>
    <span>Appointments by arrangement</span>
  </div>

  <header>
    <a href="#home" class="logo-link" aria-label="Saint Leo Medical Clinic home">
      <img
        src="logo.png"
        alt="Saint Leo Medical Clinic"
        class="logo-image"
        onerror="this.hidden=true; this.nextElementSibling.hidden=false;"
      >
      <span class="text-logo" hidden>
        SAINT LEO
        <small>MEDICAL CLINIC</small>
      </span>
    </a>

    <nav aria-label="Main navigation">
      <a href="#philosophy">Our philosophy</a>
      <a href="#services">Services</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
      <a href="#appointments" class="nav-cta">Book consultation</a>
    </nav>
  </header>

  <main>

    <section class="hero" id="home">
      <div class="hero-copy">
        <p class="eyebrow">
          Skin health · Aesthetics · Wellness
        </p>

        <h1>The art of feeling your best.</h1>

        <p>
          A considered approach to skin health, medical
          aesthetics and wellness, centred around you.
        </p>

        <a href="#appointments" class="outline-button">
          Book a consultation
        </a>
      </div>

      <div
        class="hero-image"
        role="img"
        aria-label="Beauty editorial portrait"
      ></div>
    </section>

    <section class="section" id="philosophy">
      <div class="split">
        <div
          class="interior-image"
          role="img"
          aria-label="Elegant neutral interior"
        ></div>

        <div class="split-copy">
          <p class="eyebrow">Our philosophy</p>

          <h2>Care, thoughtfully considered.</h2>

          <p>
            At Saint Leo, we believe that great care begins
            with listening. Our approach places your individual
            needs, informed decisions and personal wellbeing
            at the centre of every consultation.
          </p>

          <a href="#services" class="outline-button">
            Discover our services
          </a>
        </div>
      </div>
    </section>

    <section class="section services" id="services">
      <p class="eyebrow">The Saint Leo experience</p>

      <h2>Explore our services.</h2>

      <p class="services-intro">
        Personalised care across skin health, aesthetics
        and wellness.
      </p>

      <div class="service-grid">

        <article class="service">
          <span class="service-number">01 — SKIN</span>

          <h3>Dermatology for Skin Health</h3>

          <p>
            Individual consultations focused on skin concerns,
            assessment and appropriate care.
          </p>
        </article>

        <article class="service">
          <span class="service-number">02 — AESTHETICS</span>

          <h3>Medical Aesthetics</h3>

          <p>
            Personalised aesthetic consultations and suitable
            treatments tailored to individual needs.
          </p>
        </article>

        <article class="service">
          <span class="service-number">03 — WELLBEING</span>

          <h3>Wellness</h3>

          <p>
            Thoughtful consultations centred on your
            wellness goals and individual needs.
          </p>
        </article>

      </div>
    </section>

    <section class="section doctor-section" id="about">
      <div class="split">

        <div class="split-copy">
          <p class="eyebrow">Meet your doctor</p>

          <h2>Dr. Calista Barrow</h2>

          <p>
            Learn about Dr. Barrow's medical training,
            verified qualifications and professional
            approach to patient care.
          </p>

          <a href="#contact" class="outline-button">
            Get in touch
          </a>
        </div>

        <div class="doctor-placeholder">
          Your professional portrait can be added here.
        </div>

      </div>
    </section>

    <section class="section appointment" id="appointments">
      <p class="eyebrow">Your Saint Leo experience</p>

      <h2>Begin with a conversation.</h2>

      <p>
        Contact us to enquire about our services
        and appointment availability.
      </p>

      <a
        class="outline-button"
        href="mailto:info@saintleoclinic.com?subject=Appointment%20Enquiry"
      >
        Enquire about an appointment
      </a>
    </section>

    <section class="section contact-details" id="contact">
      <p class="eyebrow">Get in touch</p>

      <h2>Saint Leo Medical Clinic</h2>

      <p>Barbados</p>

      <p>
        <a href="mailto:info@saintleoclinic.com">
          info@saintleoclinic.com
        </a>
      </p>

      <p>
        <a href="tel:+12462313556">
          +1 (246) 231-3556
        </a>
      </p>

      <p>
        <a
          href="https://www.instagram.com/saintleoclinic/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram · @saintleoclinic
        </a>
      </p>
    </section>

  </main>

  <footer>
    <div class="text-logo">
      SAINT LEO
      <small>MEDICAL CLINIC</small>
    </div>

    <p>Barbados</p>

    <p>
      <a href="mailto:info@saintleoclinic.com">
        info@saintleoclinic.com
      </a>
    </p>

    <p>+1 (246) 231-3556</p>

    <p>
      <a
        href="https://www.instagram.com/saintleoclinic/"
        target="_blank"
        rel="noopener noreferrer"
      >
        @saintleoclinic
      </a>
    </p>

    <p class="footer-note">
      © <span id="year"></span> Saint Leo Medical Clinic.
      Website information does not replace an individual
      medical consultation.
    </p>
  </footer>

  <script>
    document.getElementById("year").textContent =
      new Date().getFullYear();
  </script>

</body>
</html>
